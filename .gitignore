# --- General ---
node_modules/
.DS_Store
Thumbs.db

# --- Next.js (Web) ---
web/.next/
web/out/
web/build/
web/.vercel/

# --- Environment Variables (SECRETS - DO NOT PUSH) ---
.env
.env.local
.env.*.local

# --- PeerTube Specific ---
# Ignore the actual data, videos, and database files
peertube/data/
peertube/docker-volume/
peertube/storage/

# Ignore local configuration that might contain secrets
# (Adjust this if your config file has a different name)
peertube/config/local-production.json
peertube/logs/

# --- Playwright ---
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# --- Documentation & Internal Scripts ---
# Ignore all markdown except README
*.md
!README.md
!web/README.md
!CONTRIBUTING.md

# Ignore migration and fix scripts (keep the actual logic files)
*.sql
*.js
web/*.js
web/*.sql
web/lint_results.txt

# --- Build Logs and Temporary Files ---
build_log*.txt
*.log
peertube/.env
test-video-insert.mjs
*.mjs
web/public/uploads/*
web/public/videos/*
web
